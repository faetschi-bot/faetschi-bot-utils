      "description": "Returns 429 when the token exceeds its per-minute limit.",
      "params": [
        { "name": "model", "in": "body", "type": "string", "required": true, "change": "modified", "was": "model_id" },
        { "name": "stream", "in": "body", "type": "boolean", "required": false, "change": "added" }
      ],
      "responses": [
        { "status": "200", "description": "OK", "example": "{\"id\":\"msg_1\"}" },
        { "status": "429", "description": "Rate limited", "change": "added", "example": "{\"error\":\"rate_limited\"}" }
      ]
    },
    {
